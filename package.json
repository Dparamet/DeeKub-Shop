{
  "name": "deekub",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:web": "node scripts/run.mjs dev:web",
    "dev:api": "node scripts/run.mjs dev:api",
    "db:migrate": "node scripts/run.mjs db:migrate",
    "admin:grant": "node scripts/run.mjs admin:grant",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "lint": "npm run lint --workspace deekub-web",
    "typecheck": "npm run typecheck --workspace deekub-web"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  }
}
